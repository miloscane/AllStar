<!DOCTYPE html>
<html lang="rs">
	<head>
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->
		<title>AllStar</title>

		<!-- Bootstrap -->
		<link href="/style.css?<%= new Date().getTime();%>" rel="stylesheet">
		<link rel="icon" type="image/x-icon" href="https://allstar.rs/favicon.png">
        <link rel="apple-touch-icon" href="https://allstar.rs/favicon.png">
        <meta property="og:title" content="All Star Pikado" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://pikado.allstar.rs" />
        <meta property="og:image" content="https://allstar.rs/images/ogImage.png" />
        <meta property="og:description" content="064/336-3-738" />
		<!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
		<!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
		<!--[if lt IE 9]>
		  <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
		  <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
		<![endif]-->
			<script src="/socket.io/socket.io.js"></script>
		<script>
		  const socket = io({});
		</script>
	</head>
	<body style="min-height:100vh;">
		<div id="porudzbine"></div>
		<div style="position:fixed;top:0;right:0;z-index:90000">
			<div style="color:rgb(255,0,0);background-color:rgb(255,255,255);padding:5px;margin-bottom:3px">Plaćanje kešom</div>
			<div style="color:rgb(0,0,255);background-color:rgb(255,255,255);padding:5px;">Plaćanje karticom</div>
		</div>
		<script>
			socket.on('porudzbina',function(json){
				//
				var brojStola = json.brojStola;
				var porudzbinaElem = document.createElement("DIV");
				var classes = String(aktivnePorudzbine[i].racun)=="1" ? "porudzbinaElem porudzbinaRacun" : String(aktivnePorudzbine[i].racun)=="2" ? "porudzbinaElem porudzbinaRacunKartica" : "porudzbinaElem";
				porudzbinaElem.setAttribute("class",classes);
				porudzbinaElem.setAttribute("onclick","this.remove();socket.emit(\"prihvaceno\",\""+brojStola+"\")");
					var brojStolaElem = document.createElement("DIV");
					brojStolaElem.setAttribute("class","brojStola");
					brojStolaElem.innerHTML = brojStola;
					porudzbinaElem.appendChild(brojStolaElem);
				document.getElementById("porudzbine").appendChild(porudzbinaElem);
			});

			socket.on('prihvacenoFeedback',function(brojStola){
				var porudzbinaElems = document.getElementsByClassName("porudzbinaElem");
				for(var i=0;i<porudzbinaElems.length;i++){
					if(porudzbinaElems[i].getElementsByClassName("brojStola")[0].innerHTML==brojStola){
						porudzbinaElems[i].remove();
					}
				}
			});

			var aktivnePorudzbine = <%- JSON.stringify(aktivnePorudzbine)-%>;
			for(var i=0;i<aktivnePorudzbine.length;i++){
				console.log(String(aktivnePorudzbine[i].racun))
				var porudzbinaElem = document.createElement("DIV");
				var classes = String(aktivnePorudzbine[i].racun)=="1" ? "porudzbinaElem porudzbinaRacun" : String(aktivnePorudzbine[i].racun)=="2" ? "porudzbinaElem porudzbinaRacunKartica" : "porudzbinaElem";
				porudzbinaElem.setAttribute("class",classes);
				porudzbinaElem.setAttribute("onclick","this.remove();socket.emit(\"prihvaceno\",\""+aktivnePorudzbine[i].brojStola+"\")");
					var brojStolaElem = document.createElement("DIV");
					brojStolaElem.setAttribute("class","brojStola");
					brojStolaElem.innerHTML = aktivnePorudzbine[i].brojStola;
					porudzbinaElem.appendChild(brojStolaElem);
				document.getElementById("porudzbine").appendChild(porudzbinaElem);
			}
		</script>
	</body>
</html>